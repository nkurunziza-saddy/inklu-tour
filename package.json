{
	"name": "inklu-tour",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"test:unit": "turbo run test --filter=@inklu/tour",
		"test:watch": "pnpm --filter=@inklu/tour test:watch",
		"test:coverage": "turbo run test:coverage",
		"test:e2e": "pnpm --filter=playground test:e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"turbo": "^2.10.5",
		"typescript": "5.9.2"
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=18"
	}
}
