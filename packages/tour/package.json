{
	"name": "@inklu/tour",
	"version": "0.1.0",
	"private": true,
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.mjs",
			"require": "./dist/react.js"
		},
		"./vue": {
			"types": "./dist/vue.d.ts",
			"import": "./dist/vue.mjs",
			"require": "./dist/vue.js"
		},
		"./svelte": {
			"types": "./dist/svelte.d.ts",
			"import": "./dist/svelte.mjs",
			"require": "./dist/svelte.js"
		}
	},
	"scripts": {
		"build": "tsup",
		"lint": "biome check .",
		"check-types": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"svelte": "^4.0.0 || ^5.0.0",
		"vue": "^3.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"vue": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"dependencies": {
		"@inklu/audio": "^0.2.1",
		"@radix-ui/react-slot": "^1.1.0"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^4.1.10",
		"jsdom": "^29.1.1",
		"svelte": "5.0.0-next.272",
		"tsup": "^8.5.1",
		"vitest": "^4.1.10",
		"vue": "^3.5.40"
	}
}
